#
# One fuzz target, without end: progmasoft-fuzz@catch3-RunnerJson.service.
# It runs on what the backups and the remote cache leave free.

[Unit]
Description=Fuzzing %i
After=network-online.target

[Service]
User=fuzz
Group=fuzz
ExecStart=/usr/local/libexec/progmasoft-fuzz/fuzz-run %i
Restart=always
RestartSec=60
Nice=19
CPUWeight=10
CPUQuota=60%
IOWeight=10
MemoryMax=2G
# libFuzzer reports each new input; the journal keeps a sample, crashes in full.
LogRateLimitIntervalSec=60s
LogRateLimitBurst=200
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/progmasoft-fuzz

[Install]
WantedBy=multi-user.target
